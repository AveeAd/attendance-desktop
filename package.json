{
  "name": "attendance-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/desktop", "apps/server"],
  "scripts": {
    "desktop:dev": "npm run dev -w @attendance/desktop",
    "desktop:build": "npm run build -w @attendance/desktop",
    "desktop:test": "npm test -w @attendance/desktop",
    "desktop:tauri": "npm run tauri -w @attendance/desktop",
    "server:dev": "npm run dev -w @attendance/server",
    "server:build": "npm run build -w @attendance/server",
    "server:start": "npm run start -w @attendance/server",
    "server:test": "npm test -w @attendance/server",
    "check": "npm run desktop:build && npm run desktop:test && npm run server:build && npm run server:test"
  }
}
